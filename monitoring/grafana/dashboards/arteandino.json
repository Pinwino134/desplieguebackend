    {
      "id": 12,
      "type": "timeseries",
      "title": "Conexiones a la base de datos",
      "description": "Pool Hikari: conexiones en espera = cuello de botella",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{job=~\"$servicio\"}",
          "legendFormat": "{{job}} activas",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_pending{job=~\"$servicio\"}",
          "legendFormat": "{{job}} en espera",
          "refId": "B"

          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"$servicio\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",

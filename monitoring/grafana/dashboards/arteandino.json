      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (jvm_memory_used_bytes{job=~\"$servicio\",area=\"heap\"})",
          "legendFormat": "{{job}}",

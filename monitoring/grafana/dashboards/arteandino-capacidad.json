{
  "title": "Arte Andino — Capacidad y Rendimiento de Microservicios",
  "uid": "arteandino-capacidad",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Servicios Activos (UP)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "count(up{job=\"arteandino-microservices\"} == 1)", "legendFormat": "UP" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Solicitudes HTTP por Segundo (RPS)",
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "targets": [
        { "expr": "sum by (application) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{application}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia HTTP p95 (segundos)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{application}} p95" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Uso de Memoria JVM Heap (MB)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"}) / 1048576", "legendFormat": "{{application}}" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasa de Errores HTTP 5xx",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 7 },
      "targets": [
        { "expr": "sum by (application) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m]))", "legendFormat": "{{application}} 5xx" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Conexiones Activas HikariCP",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 7 },
      "targets": [
        { "expr": "hikaricp_connections_active", "legendFormat": "{{application}}" }
      ]
    }
  ]
}
